# ============================================================================
# DevMate —— 环境变量样例（可安全提交到公开仓库）
# 用法：Copy-Item .env.example .env  然后填入你自己的真实凭证
# 说明：本项目所有自有配置统一走 DEVMATE_ 前缀（pydantic-settings env_prefix="DEVMATE_"）
#       LangSmith 例外：官方 SDK 只认 LANGSMITH_* 无前缀变量，这里两种都列出
# ⚠️ 本文件只放键名和占位符，绝不写真 key。真 .env 已被 .gitignore 忽略。
# ============================================================================

# ===== 模型（主模型 + 三档路由） =====
DEVMATE_MODEL_NAME=your-model-name-here
DEVMATE_MODEL_PROVIDER=openai
DEVMATE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEVMATE_API_KEY=sk-replace-with-your-key
# 思考强度：low / medium / high（不支持的模型会被 Harness Profile 忽略）
DEVMATE_MODEL_REASONING_EFFORT=low
# 三档模型路由（不写则用 infra/settings.py 里的默认值）
# DEVMATE_MODEL_TIERS={"strong":"qwen3.7-max","standard":"qwen3.7-plus","cheap":"qwen3.5-flash"}

# ===== 连接弹性 =====
DEVMATE_MAX_RETRIES=12
DEVMATE_TIMEOUT=60

# ===== 持久化 =====
# 注意：字段名是 database_url，所以环境变量必须写 DEVMATE_DATABASE_URL
#       （DEVMATE_POSTGRES_URL 是无效键，会被 pydantic 忽略 —— 历史坑，勿再写错）
DEVMATE_DATABASE_URL=postgresql://devmate:devmate@localhost:5432/devmate
DEVMATE_PG_POOL_MIN=2
DEVMATE_PG_POOL_MAX=20
DEVMATE_REDIS_URL=redis://localhost:6379/0
DEVMATE_REDIS_POOL_MAX=20

# ===== 运行时 =====
DEVMATE_LOG_LEVEL=INFO

# ===== 网关鉴权 / 多租户 =====
# 单行 JSON：API Key -> tenant_id。生产请换成随机长字符串。
# ⚠ 必填：/issues、/jobs、/webhook/generic 都会调模型，没配 key = 全部 401（不是"不鉴权"）。
DEVMATE_API_KEYS={"key-a":"tenant-a"}

# ===== 沙箱 =====
DEVMATE_SANDBOX_PROVIDER=docker          # docker（自托管）/ daytona（外部托管）
DEVMATE_SANDBOX_RUNTIME=runc             # runc（加固容器）/ runsc（gVisor）/ kata（microVM）
DEVMATE_SANDBOX_IMAGE=devmate-sandbox:latest
DEVMATE_SANDBOX_WORKDIR=/home/agent
DEVMATE_SANDBOX_MEM_LIMIT=512m
DEVMATE_SANDBOX_PIDS_LIMIT=256
DEVMATE_SANDBOX_CPUS=1.0
DEVMATE_SANDBOX_POOL_SIZE=4

# ===== 并发治理 =====
DEVMATE_MAX_CONCURRENT_LLM=8

# ===== 限流开关（压测用） =====
# 压测时临时设 false，压完必须改回 true（否则线上无保护）
DEVMATE_RATELIMIT_ENABLED=true

# ===== 跨域白名单 =====
# 逗号分隔的具体来源，默认只放行本机 8010 的静态页。
# ⚠ 别写 *：那等于允许任意网页驱动你的后端，配合会调模型的端点就是公开钱包。
DEVMATE_CORS_ALLOW_ORIGINS=http://localhost:8010,http://127.0.0.1:8010

# ===== LangSmith 可观测（可选） =====
DEVMATE_LANGSMITH_TRACING=true
DEVMATE_LANGSMITH_API_KEY=lsv2-pt-replace-with-your-key
DEVMATE_LANGSMITH_PROJECT=devmate
DEVMATE_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 等价的官方无前缀写法（给 SDK 直接识别用，二选一即可）
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-pt-replace-with-your-key

# ===== 飞书渠道（不接飞书可全部留空） =====
DEVMATE_FEISHU_APP_ID=cli_replace-with-your-app-id
DEVMATE_FEISHU_APP_SECRET=replace-with-your-app-secret
# 长连接模式（channels/feishu_ws.py）下面两项留空即可 —— 它走出站 wss，不接回调。
# 只有走 Webhook 回调（POST /webhook/feishu）才要填，两项作用不同：
#   ENCRYPT_KEY：① 验签 sha256(timestamp+nonce+ENCRYPT_KEY+原始body) 比 X-Lark-Signature；
#               ② 飞书后台开了加密时，body 会是 {"encrypt":...}，用它 AES-256-CBC 解密。
#               不填 = 无法验签，端点会跳过并打一次 warning —— 此时别暴露到公网。
#   VERIFICATION_TOKEN：填了就必须和飞书后台一致；注意它藏在解密后的 payload 里
#               （v2 在 header.token），不是请求头。若飞书后台没配 token，这里留空。
DEVMATE_FEISHU_ENCRYPT_KEY=
DEVMATE_FEISHU_VERIFICATION_TOKEN=

# ===== Daytona 外部沙箱（只在对比外部托管沙箱时才需要） =====
# DAYTONA_API_KEY=
# DAYTONA_TARGET=us
